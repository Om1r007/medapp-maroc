# ============================================================
# MEDAPP MAROC - Environment Variables
# Copie ce fichier vers .env et remplis les valeurs
# ============================================================

# ---------- Database ----------
DATABASE_URL="postgresql://medapp:medapp_dev_password@localhost:5432/medapp_dev?schema=public"
REDIS_URL="redis://localhost:6379"

# ---------- API ----------
API_PORT=4000
NODE_ENV=development

# ---------- Auth (génère des secrets longs et aléatoires en prod !) ----------
JWT_SECRET="change-me-use-openssl-rand-base64-32"
JWT_REFRESH_SECRET="change-me-too-different-from-above"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- CORS / Frontend URLs ----------
APP_URL_PATIENT=http://localhost:3000
APP_URL_DOCTOR=http://localhost:3001

# ---------- SMS (Twilio en dev, Mobiblanc/Inwi en prod Maroc) ----------
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------- Vidéo ----------
# VIDEO_PROVIDER=daily pour la prod, mock pour dev sans clé
# Clé gratuite sur https://dashboard.daily.co → Settings → Developer
VIDEO_PROVIDER=daily
DAILY_API_KEY=                  # Bearer token depuis dashboard.daily.co
DAILY_DOMAIN=                   # ex: monapp.daily.co (sans https://)

# ---------- Paiement ----------
PAYMENT_PROVIDER=mock  # mock | cmi

# ---------- File d'attente ----------
QUEUE_TIMEOUT_MINUTES=15   # délai avant remboursement automatique
AVG_CONSULTATION_MINUTES=4 # durée moyenne par consultation (pour l'estimation)

# CMI (à obtenir après convention banque)
CMI_MERCHANT_ID=
CMI_STORE_KEY=
CMI_CALLBACK_URL=http://localhost:4000/payments/cmi/callback

# ---------- Storage (S3 ou Supabase) ----------
S3_BUCKET=medapp-uploads
S3_REGION=eu-west-3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Monitoring ----------
SENTRY_DSN=

# ---------- Frontend Public Vars (préfixe NEXT_PUBLIC_) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
