// Prisma schema — Medapp Maroc
// Doc: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS & AUTH
// ============================================================

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient  Patient?
  doctor   Doctor?
  invoices Invoice[] @relation("InvoiceRecipient")

}

// ============================================================
// PATIENTS
// ============================================================

model Patient {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  cin         String   @unique
  dateOfBirth DateTime

  consultations Consultation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cin])
}

// ============================================================
// DOCTORS
// ============================================================

enum DoctorStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model Doctor {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName       String
  lastName        String
  cin             String       @unique
  ordreNumber     String       @unique // N° Ordre National des Médecins
  speciality      String
  bio             String?
  consultationFee Decimal      @default(150.00) @db.Decimal(10, 2) // MAD
  status          DoctorStatus @default(PENDING)
  isAvailable     Boolean      @default(false)

  consultations         Consultation[]
  ratings               Rating[]
  availabilitySlots     AvailabilitySlot[]
  availabilityExceptions AvailabilityException[]

  // Override manuel : null = suivre le calendrier ; true/false = forcer
  manualOverride      Boolean?
  manualOverrideUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, isAvailable])
  @@index([speciality])
}

// ============================================================
// CONSULTATIONS
// ============================================================

enum ConsultationStatus {
  WAITING_PAYMENT
  IN_QUEUE
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Consultation {
  id            String             @id @default(cuid())
  patientId     String
  patient       Patient            @relation(fields: [patientId], references: [id])
  doctorId      String?
  doctor        Doctor?            @relation(fields: [doctorId], references: [id])

  status        ConsultationStatus @default(WAITING_PAYMENT)
  reason        String?            // Motif de consultation indiqué par le patient
  diagnosis     String?            // Compte-rendu du médecin
  prescription  String?

  amount        Decimal            @db.Decimal(10, 2) // MAD
  paymentStatus PaymentStatus      @default(PENDING)
  paymentRef    String?            // Référence transaction CMI

  videoRoomUrl  String?
  videoRoomId   String?

  queuedAt            DateTime?
  matchedAt           DateTime?
  startedAt           DateTime?
  endedAt             DateTime?
  autoClosedByTimeout Boolean   @default(false)

  rating  Rating?
  invoice Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([patientId, createdAt])
  @@index([doctorId, createdAt])
}

// ============================================================
// AVAILABILITY CALENDAR (Brique 5a)
// ============================================================

enum ExceptionType {
  BLOCKED            // Indisponible même si le créneau récurrent dit dispo
  EXTRA_AVAILABILITY // Disponible exceptionnellement hors créneaux récurrents
}

// Créneaux récurrents (gabarit hebdomadaire)
model AvailabilitySlot {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  dayOfWeek Int      // 0 = dimanche, 1 = lundi, ..., 6 = samedi
  startTime String   // "HH:mm" en heure locale Africa/Casablanca
  endTime   String   // "HH:mm" en heure locale Africa/Casablanca

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId, dayOfWeek])
}

// Exceptions ponctuelles (vacances, RDV externe, etc.)
model AvailabilityException {
  id        String        @id @default(cuid())
  doctorId  String
  doctor    Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  startsAt  DateTime
  endsAt    DateTime
  type      ExceptionType
  reason    String?

  createdAt DateTime @default(now())

  @@index([doctorId, startsAt])
}

// ============================================================
// RATING (non visible côté patient → côté médecin uniquement)
// ============================================================

model Rating {
  id             String       @id @default(cuid())
  consultationId String       @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  doctorId       String
  doctor         Doctor       @relation(fields: [doctorId], references: [id])

  score    Int    // 1 à 5
  comment  String?

  createdAt DateTime @default(now())

  @@index([doctorId])
}

// ============================================================
// INVOICES — Brique 5c (Facturation PDF)
// ============================================================

enum InvoiceType {
  PAYMENT_RECEIPT  // reçu patient par consultation
  MONTHLY_INVOICE  // facture mensuelle médecin (rétrocession)
}

enum InvoiceStatus {
  ISSUED
  CANCELLED
  PAID
}

model Invoice {
  id              String        @id @default(cuid())
  type            InvoiceType
  number          String        @unique  // RECU-2026-0001 ou FAC-2026-0001
  issuedAt        DateTime      @default(now())
  periodStart     DateTime?     // pour MONTHLY_INVOICE
  periodEnd       DateTime?     // pour MONTHLY_INVOICE
  recipientUserId String
  recipientName   String        // figé à l'émission
  recipientIce    String?       // si professionnel
  amountHt        Decimal       @db.Decimal(10, 2)
  tvaAmount       Decimal       @db.Decimal(10, 2) @default(0)
  amountTtc       Decimal       @db.Decimal(10, 2)
  currency        String        @default("MAD")
  pdfPath         String
  status          InvoiceStatus @default(ISSUED)
  consultationId  String?       @unique  // lien si PAYMENT_RECEIPT
  doctorId        String?       // lien si MONTHLY_INVOICE
  metadata        Json?         // détails (nb consultations, totaux…)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  recipient    User          @relation("InvoiceRecipient", fields: [recipientUserId], references: [id])
  consultation Consultation? @relation(fields: [consultationId], references: [id])

  @@index([recipientUserId, type])
  @@index([type, periodStart])
  @@index([doctorId, type])
}
