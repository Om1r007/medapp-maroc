// Prisma schema — Medapp Maroc
// Doc: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS & AUTH
// ============================================================

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient  Patient?
  doctor   Doctor?
  invoices Invoice[] @relation("InvoiceRecipient")

}

// ============================================================
// PATIENTS
// ============================================================

enum Sex {
  M
  F
  OTHER
}

model Patient {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  cin         String   @unique
  dateOfBirth DateTime

  // Profil étendu — Brique 6
  photoUrl    String?
  sex         Sex?
  city        String?
  bloodType   String?   // A+, A-, B+, B-, AB+, AB-, O+, O-, Inconnu
  heightCm    Int?
  weightKg    Int?
  allergies   String[]  @default([])
  conditions  String[]  @default([])
  medications String[]  @default([])

  consultations   Consultation[]
  sharingConsent  SharingConsent?
  fileAccessLogs  PatientFileAccessLog[]

  // Médecin référent — Brique 6.4
  referringDoctorId String?
  referringDoctor   Doctor?   @relation("ReferringDoctor", fields: [referringDoctorId], references: [id])
  referringSetAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cin])
}

// ============================================================
// DOCTORS
// ============================================================

enum DoctorStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum VerificationStep {
  IDENTITY
  PROFESSIONAL
  PROFILE
  APPROVED
}

model Doctor {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName       String
  lastName        String
  cin             String       @unique
  inpe            String?      @unique // Identifiant National des Professions de Santé
  ordreNumber     String       @unique // N° Ordre National des Médecins
  speciality      String
  bio             String?
  diplomaUrl      String?
  diplomaUniversity String?
  diplomaYear     Int?
  yearsOfExperience Int?
  languages       String[]     @default([])
  profilePhotoUrl String?
  consultationFee Decimal      @default(150.00) @db.Decimal(10, 2) // MAD
  status          DoctorStatus @default(PENDING)
  isAvailable     Boolean      @default(false)

  verificationStep    VerificationStep @default(IDENTITY)
  verifiedAt          DateTime?
  verifiedByAdminId   String?

  qualityScore    Float?
  totalRatings    Int          @default(0)
  suspensionReason String?
  suspendedAt     DateTime?

  consultations           Consultation[]
  ratings                 Rating[]
  availabilitySlots       AvailabilitySlot[]
  availabilityExceptions  AvailabilityException[]
  fileAccessLogs          PatientFileAccessLog[]
  referringPatients       Patient[]               @relation("ReferringDoctor")
  requestedConsultations  Consultation[]          @relation("RequestedDoctor")

  // Override manuel : null = suivre le calendrier ; true/false = forcer
  manualOverride      Boolean?
  manualOverrideUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, isAvailable])
  @@index([speciality])
}

// ============================================================
// CONSULTATIONS
// ============================================================

enum ConsultationStatus {
  WAITING_PAYMENT
  WAITING_PRE_CONSULT
  IN_QUEUE
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PreConsultMode {
  STANDARD
  EXPRESS
  URGENT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Consultation {
  id            String             @id @default(cuid())
  patientId     String
  patient       Patient            @relation(fields: [patientId], references: [id])
  doctorId      String?
  doctor        Doctor?            @relation(fields: [doctorId], references: [id])

  status        ConsultationStatus @default(WAITING_PAYMENT)
  reason        String?            // Motif de consultation indiqué par le patient
  diagnosis     String?            // Compte-rendu du médecin
  prescription  String?

  amount        Decimal            @db.Decimal(10, 2) // MAD
  paymentStatus PaymentStatus      @default(PENDING)
  paymentRef    String?            // Référence transaction CMI

  videoRoomUrl  String?
  videoRoomId   String?

  preConsultData      Json?
  preConsultMode      PreConsultMode @default(STANDARD)
  preConsultFilledAt  DateTime?

  excludedFromSharing Boolean   @default(false)
  excludedReason      String?
  excludedAt          DateTime?

  // Médecin référent — Brique 6.4
  requestedDoctorId  String?
  requestedDoctor    Doctor?   @relation("RequestedDoctor", fields: [requestedDoctorId], references: [id])
  isReferringRequest Boolean   @default(false)
  fallbackedAt       DateTime?
  fallbackReason     String?

  queuedAt            DateTime?
  matchedAt           DateTime?
  startedAt           DateTime?
  endedAt             DateTime?
  autoClosedByTimeout Boolean   @default(false)

  rating  Rating?
  invoice Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([patientId, createdAt])
  @@index([doctorId, createdAt])
}

// ============================================================
// AVAILABILITY CALENDAR (Brique 5a)
// ============================================================

enum ExceptionType {
  BLOCKED            // Indisponible même si le créneau récurrent dit dispo
  EXTRA_AVAILABILITY // Disponible exceptionnellement hors créneaux récurrents
}

// Créneaux récurrents (gabarit hebdomadaire)
model AvailabilitySlot {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  dayOfWeek Int      // 0 = dimanche, 1 = lundi, ..., 6 = samedi
  startTime String   // "HH:mm" en heure locale Africa/Casablanca
  endTime   String   // "HH:mm" en heure locale Africa/Casablanca

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId, dayOfWeek])
}

// Exceptions ponctuelles (vacances, RDV externe, etc.)
model AvailabilityException {
  id        String        @id @default(cuid())
  doctorId  String
  doctor    Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  startsAt  DateTime
  endsAt    DateTime
  type      ExceptionType
  reason    String?

  createdAt DateTime @default(now())

  @@index([doctorId, startsAt])
}

// ============================================================
// RATING (non visible côté patient → côté médecin uniquement)
// ============================================================

model Rating {
  id             String       @id @default(cuid())
  consultationId String       @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  doctorId       String
  doctor         Doctor       @relation(fields: [doctorId], references: [id])
  patientId      String

  stars    Int             // 1 à 5
  feedback String?
  tags     String[]        @default([])

  createdAt DateTime @default(now())

  @@index([doctorId])
  @@index([patientId])
}

// ============================================================
// INVOICES — Brique 5c (Facturation PDF)
// ============================================================

enum InvoiceType {
  PAYMENT_RECEIPT  // reçu patient par consultation
  MONTHLY_INVOICE  // facture mensuelle médecin (rétrocession)
}

enum InvoiceStatus {
  ISSUED
  CANCELLED
  PAID
}

model Invoice {
  id              String        @id @default(cuid())
  type            InvoiceType
  number          String        @unique  // RECU-2026-0001 ou FAC-2026-0001
  issuedAt        DateTime      @default(now())
  periodStart     DateTime?     // pour MONTHLY_INVOICE
  periodEnd       DateTime?     // pour MONTHLY_INVOICE
  recipientUserId String
  recipientName   String        // figé à l'émission
  recipientIce    String?       // si professionnel
  amountHt        Decimal       @db.Decimal(10, 2)
  tvaAmount       Decimal       @db.Decimal(10, 2) @default(0)
  amountTtc       Decimal       @db.Decimal(10, 2)
  currency        String        @default("MAD")
  pdfPath         String
  status          InvoiceStatus @default(ISSUED)
  consultationId  String?       @unique  // lien si PAYMENT_RECEIPT
  doctorId        String?       // lien si MONTHLY_INVOICE
  metadata        Json?         // détails (nb consultations, totaux…)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  recipient    User          @relation("InvoiceRecipient", fields: [recipientUserId], references: [id])
  consultation Consultation? @relation(fields: [consultationId], references: [id])

  @@index([recipientUserId, type])
  @@index([type, periodStart])
  @@index([doctorId, type])
}

// ============================================================
// DOSSIER PATIENT PARTAGÉ — Brique 6.3
// ============================================================

enum ConsentAction {
  ENABLED
  DISABLED
  CGU_UPDATED
}

enum FileAccessType {
  VIEW_PROFILE
  VIEW_HISTORY
  VIEW_CONSULTATION
  VIEW_DOCUMENT
}

model SharingConsent {
  id            String       @id @default(cuid())
  patientId     String       @unique
  isEnabled     Boolean      @default(false)
  enabledAt     DateTime?
  disabledAt    DateTime?
  cguVersion    String
  ipAddressHash String
  userAgent     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  patient       Patient      @relation(fields: [patientId], references: [id])
  logs          ConsentLog[]
}

model ConsentLog {
  id        String        @id @default(cuid())
  consentId String
  action    ConsentAction
  timestamp DateTime      @default(now())
  ipHash    String

  consent   SharingConsent @relation(fields: [consentId], references: [id])

  @@index([consentId, timestamp])
}

model PatientFileAccessLog {
  id             String         @id @default(cuid())
  patientId      String
  doctorId       String
  consultationId String?
  accessType     FileAccessType
  accessedAt     DateTime       @default(now())
  ipHash         String

  patient        Patient        @relation(fields: [patientId], references: [id])
  doctor         Doctor         @relation(fields: [doctorId], references: [id])

  @@index([patientId, accessedAt])
  @@index([doctorId, accessedAt])
}
