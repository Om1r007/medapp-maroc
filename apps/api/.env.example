# ============================================================
# API — Variables d'environnement
# Copie ce fichier vers .env et remplis les valeurs
# ============================================================

# ---------- Database ----------
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ---------- Redis ----------
REDIS_URL="redis://localhost:6379"

# ---------- API ----------
API_PORT=4000
NODE_ENV=production

# ---------- Auth ----------
JWT_SECRET="change-me-use-openssl-rand-base64-32"
JWT_REFRESH_SECRET="change-me-too-different-from-above"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- CORS / Frontend URLs ----------
APP_URL_PATIENT=https://patient.ton-domaine.com
APP_URL_DOCTOR=https://doctor.ton-domaine.com

# ---------- Vidéo ----------
VIDEO_PROVIDER=daily
DAILY_API_KEY=
DAILY_DOMAIN=

# ---------- Paiement ----------
PAYMENT_PROVIDER=mock
CMI_MERCHANT_ID=
CMI_STORE_KEY=
CMI_CALLBACK_URL=https://api.ton-domaine.com/payments/cmi/callback

# ---------- File d'attente ----------
QUEUE_TIMEOUT_MINUTES=15
AVG_CONSULTATION_MINUTES=4

# ---------- Calendrier de disponibilité ----------
AVAILABILITY_CRON_EXPRESSION="0 * * * * *"
TIMEZONE="Africa/Casablanca"

# ---------- Clôture automatique des consultations ----------
CONSULTATION_AUTO_CLOSE_HOURS=1

# ---------- Storage ----------
S3_BUCKET=medapp-uploads
S3_REGION=eu-west-3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Monitoring ----------
SENTRY_DSN=
